# Copy to .env for local development and replace both secrets.
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
POSTGRES_PORT=5433
KUSI_ADMIN_API_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=postgres://kusi:replace-with-a-long-random-local-password@127.0.0.1:5433/kusi

# No channels enabled by default; see docs/CHANNELS.md.
KUSI_CHANNELS={}

# Disabled until tenant profiles and authorized credentials are configured.
KUSI_LLM_PROFILES={}
KUSI_AUDIO_PROFILES={}

# Read-only platform adapters are disabled by default and forbidden in local mode.
# Credentials live in private 0600 JSON files: {"username":"...","password":"..."}.
KUSI_SYSTEM_PROFILES={}
KUSI_SYSTEM_ALLOWED_HOSTS=
KUSI_SYSTEM_PRIVATE_HTTP=false
# KUSI_SYSTEM_PROFILES={"tenant-uuid":{"crm":{"kind":"frappe_identity","base_url":"https://crm.example.com","host":"crm.example.com","credential_file":"/run/secrets/crm.json"}}}
# Other kinds: plane_identity, wppconnect_health (no credential_file).
# PRIVATE_HTTP requires an explicit literal private/loopback IPv4 base_url; never use in local mode.

# Creative jobs: no recipes or paid worker enabled by default.
KUSI_CREATIVE_RECIPES={}
KUSI_CREATIVE_WORKER=false
KUSI_CREATIVE_SIMULATION=false

# Social OAuth is disabled until profiles and an encryption keyring are configured.
KUSI_OAUTH_PROFILES={}
KUSI_OAUTH_SIMULATION=false
KUSI_OAUTH_REFRESH_WORKER=false
# KUSI_OAUTH_KEYRING='{"v1":"OAUTH_TOKEN_KEY_V1"}'
# KUSI_OAUTH_ACTIVE_KEY=v1
# OAUTH_TOKEN_KEY_V1 must be 32 random bytes encoded as 64 hex characters.

# Local product workspace. Backend and frontend origins must be loopback.
KUSI_LOCAL_MODE=false
KUSI_LOCAL_STORAGE=.local-data
# KUSI_LOCAL_ORIGIN=http://127.0.0.1:3000
# KUSI_API_ORIGIN=http://127.0.0.1:8080

# Production admin control plane only. Leave all unset in local mode.
# KUSI_ADMIN_PUBLIC_ORIGIN=https://admin.example.com
# KUSI_ADMIN_OIDC_ISSUER=https://identity.example.com
# KUSI_ADMIN_OIDC_CLIENT_ID=kusi-admin
# KUSI_ADMIN_OIDC_CLIENT_SECRET=deliver-through-secret-manager
# KUSI_ADMIN_OIDC_REDIRECT_URI=https://admin.example.com/v1/admin/auth/oidc/callback
# KUSI_ADMIN_OIDC_STATE_KEY=64-hex-characters-from-32-random-bytes
NEXT_TELEMETRY_DISABLED=1
# DEMO_ORGANIZATION_API_KEY=save-the-provisioned-tenant-key-here
# scripts/run_local.sh explicitly enables the local/simulated workers.
