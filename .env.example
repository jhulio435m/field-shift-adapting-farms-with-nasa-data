# Port exposed on the host by Docker Compose v2
PORT=8000

# Shared HMAC-SHA256 secret (min 32 chars) between Field Shift and Kusi Kusi
FIELD_SHIFT_KUSI_VERIFY_KEY=replace-with-at-least-32-random-characters

# Set to 1 for live demos (auto-verifies in 1 click without external callback)
FIELD_SHIFT_DEMO_MODE=0

# Optional: Kusi Kusi stack (--profile kusi) for VPS deployment
KUSI_PORT=8080
POSTGRES_PASSWORD=replace-with-strong-postgres-password
KUSI_ADMIN_API_KEY=replace-with-strong-kusi-admin-key
